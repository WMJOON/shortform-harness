# Shortform Harness — 환경 변수 템플릿
# 복사 후 .env로 저장하고 실제 키를 입력하세요
# cp .env.example .env

# ── 비주얼 생성 ──────────────────────────────────
# GPT Image 2 (scene_generator visual=gpt_image_2)
OPENAI_API_KEY=sk-...

# Kling AI (scene_generator visual=kling)
KLING_API_KEY=

# ── TTS ──────────────────────────────────────────
# ElevenLabs (subtitle_generator tts_voice_id 사용 시)
ELEVENLABS_API_KEY=

# ── (선택) 로깅 ───────────────────────────────────
# HARNESS_LOG_LEVEL=INFO
